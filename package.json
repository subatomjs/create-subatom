{
  "name": "create-subatom",
  "version": "0.10.4",
  "description": "CLI tool of subatom framework.",
  "type": "module",
  "main": "./dist/create.js",
  "bin": {
    "create-subatom": "./dist/bin/create.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [
    "subatom",
    "framework",
    "cli",
    "tool",
    "scaffold",
    "generator"
  ],
  "license": "MIT",
  "author": "Kunal Chandra Das <kunalchandradasofficial@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subatomjs/subatom.git"
  },
  "engines": {
    "node": ">= 24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run typecheck && tsdown && tsx src/helpers/copyFolder.ts && chmod +x dist/bin/create.js",
    "pre-publish": "npm run test:e2e && npm run test:unit-coverage && npm run lint:fix && npm run build",
    "dev": "tsx src/bin/create.ts",
    "prepublishOnly": "npm run build",
    "test:unit": "npx vitest run",
    "test:unit-coverage": "npx vitest run --coverage",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "lint": "biome lint src tests",
    "lint:fix": "biome lint --write src tests",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "cpy-cli": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "picocolors": "^1.1.1",
    "tsdown": "^0.23.0"
  }
}
