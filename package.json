{
  "name": "create-subatom",
  "version": "0.6.0",
  "description": "CLI tool of subatom framework.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "create-subatom": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [
    "subatom",
    "framework",
    "cli",
    "tool",
    "scaffold",
    "generator"
  ],
  "license": "MIT",
  "author": "Kunal Chandra Das <kunalchandradasofficial@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subatomjs/subatom.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json && tsx src/helpers/copy-folder.ts",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "cpy-cli": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "picocolors": "^1.1.1"
  }
}
